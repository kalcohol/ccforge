if(NOT DEFINED FORGE_INSTALL_PREFIX)
    message(FATAL_ERROR "FORGE_INSTALL_PREFIX is required")
endif()
file(GLOB_RECURSE version_files "${FORGE_INSTALL_PREFIX}/*/CCForgeConfigVersion.cmake")
list(LENGTH version_files version_count)
if(NOT version_count EQUAL 1)
    message(FATAL_ERROR "Expected one installed CCForgeConfigVersion.cmake")
endif()
list(GET version_files 0 version_file)
foreach(pointer_width IN ITEMS 4 8)
    set(CMAKE_SIZEOF_VOID_P "${pointer_width}")
    set(PACKAGE_FIND_VERSION 0.1.0)
    set(PACKAGE_FIND_VERSION_MAJOR 0)
    set(PACKAGE_FIND_VERSION_MINOR 1)
    set(PACKAGE_FIND_VERSION_PATCH 0)
    unset(PACKAGE_VERSION_UNSUITABLE)
    include("${version_file}")
    if(NOT PACKAGE_VERSION_COMPATIBLE OR NOT PACKAGE_VERSION_EXACT OR PACKAGE_VERSION_UNSUITABLE)
        message(FATAL_ERROR "Installed header-only package rejected pointer width ${pointer_width}")
    endif()
    foreach(incompatible_version IN ITEMS 0.0.0 0.2.0 1.1.0 0.1.1)
        set(PACKAGE_FIND_VERSION "${incompatible_version}")
        string(REPLACE "." ";" version_parts "${incompatible_version}")
        list(GET version_parts 0 PACKAGE_FIND_VERSION_MAJOR)
        list(GET version_parts 1 PACKAGE_FIND_VERSION_MINOR)
        list(GET version_parts 2 PACKAGE_FIND_VERSION_PATCH)
        include("${version_file}")
        if(PACKAGE_VERSION_COMPATIBLE)
            message(FATAL_ERROR "Installed package accepted incompatible version ${incompatible_version}")
        endif()
    endforeach()
endforeach()
message(STATUS "Installed version accepted both widths and rejected other minor/major and newer patch requests")
