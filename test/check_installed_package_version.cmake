if(NOT DEFINED FORGE_INSTALL_PREFIX)
    message(FATAL_ERROR "FORGE_INSTALL_PREFIX is required")
endif()
file(GLOB_RECURSE version_files "${FORGE_INSTALL_PREFIX}/*/CCForgeConfigVersion.cmake")
list(LENGTH version_files version_count)
if(NOT version_count EQUAL 1)
    message(FATAL_ERROR "Expected one installed CCForgeConfigVersion.cmake")
endif()
list(GET version_files 0 version_file)
foreach(pointer_width IN ITEMS 4 8)
    set(CMAKE_SIZEOF_VOID_P "${pointer_width}")
    set(PACKAGE_FIND_VERSION 1.0.0)
    set(PACKAGE_FIND_VERSION_MAJOR 1)
    unset(PACKAGE_VERSION_UNSUITABLE)
    include("${version_file}")
    if(NOT PACKAGE_VERSION_COMPATIBLE OR NOT PACKAGE_VERSION_EXACT OR PACKAGE_VERSION_UNSUITABLE)
        message(FATAL_ERROR "Installed header-only package rejected pointer width ${pointer_width}")
    endif()
    set(PACKAGE_FIND_VERSION 2.0.0)
    set(PACKAGE_FIND_VERSION_MAJOR 2)
    include("${version_file}")
    if(PACKAGE_VERSION_COMPATIBLE)
        message(FATAL_ERROR "Installed package accepted incompatible major version")
    endif()
endforeach()
message(STATUS "Installed version controls accepted both widths and rejected incompatible major")
