#pragma once

#include <cstddef>

namespace std {
namespace simd {

template<class T, std::size_t N = 4>
struct basic_vec {
    T data[N];

    constexpr basic_vec(T value) : data{} {
        for (std::size_t i = 0; i < N; ++i) {
            data[i] = value;
        }
    }

    constexpr T operator[](std::size_t i) const noexcept {
        return data[i];
    }
};

template<class T, std::size_t N = 4>
using vec = basic_vec<T, N>;

} // namespace simd
} // namespace std
