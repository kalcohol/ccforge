#pragma once

#include <concepts>
#include <type_traits>
#include <utility>

namespace std {

class inplace_stop_source;
class inplace_stop_token;

template<class Callback>
class inplace_stop_callback;

class inplace_stop_token {
public:
    template<class Callback>
    using callback_type = inplace_stop_callback<Callback>;

    inplace_stop_token() noexcept = default;

    [[nodiscard]] bool stop_requested() const noexcept;
    [[nodiscard]] bool stop_possible() const noexcept {
        return source_ != nullptr;
    }

    friend bool operator==(
        const inplace_stop_token&,
        const inplace_stop_token&) noexcept = default;

private:
    friend class inplace_stop_source;

    explicit inplace_stop_token(const inplace_stop_source* source) noexcept
        : source_(source)
    {}

    const inplace_stop_source* source_ = nullptr;
};

class inplace_stop_source {
public:
    [[nodiscard]] inplace_stop_token get_token() const noexcept {
        return inplace_stop_token{this};
    }

    bool request_stop() noexcept {
        return !std::exchange(stop_requested_, true);
    }

    [[nodiscard]] bool stop_requested() const noexcept {
        return stop_requested_;
    }

private:
    bool stop_requested_ = false;
};

inline bool inplace_stop_token::stop_requested() const noexcept {
    return source_ && source_->stop_requested();
}

template<class Callback>
class inplace_stop_callback {
public:
    template<class Initializer>
    explicit inplace_stop_callback(inplace_stop_token, Initializer&& callback)
        noexcept(std::is_nothrow_constructible_v<Callback, Initializer>)
        : callback_(std::forward<Initializer>(callback))
    {}

private:
    [[no_unique_address]] Callback callback_;
};

template<class Callback>
inplace_stop_callback(inplace_stop_token, Callback)
    -> inplace_stop_callback<Callback>;

struct never_stop_token {
    template<class Callback>
    class callback_type {
    public:
        template<class Initializer>
        explicit callback_type(never_stop_token, Initializer&&) noexcept {}
    };

    [[nodiscard]] static constexpr bool stop_requested() noexcept {
        return false;
    }

    [[nodiscard]] static constexpr bool stop_possible() noexcept {
        return false;
    }

    friend bool operator==(
        const never_stop_token&,
        const never_stop_token&) noexcept = default;
};

template<class Token, class Callback>
using stop_callback_for_t =
    typename Token::template callback_type<Callback>;

namespace synthetic_stop_detail {

struct callback {
    void operator()() const noexcept {}
};

} // namespace synthetic_stop_detail

template<class Token>
concept stoppable_token =
    copy_constructible<Token> &&
    equality_comparable<Token> &&
    requires(const Token& token) {
        typename Token::template callback_type<
            synthetic_stop_detail::callback>;
        { token.stop_requested() } noexcept -> same_as<bool>;
        { token.stop_possible() } noexcept -> same_as<bool>;
    };

template<class Token>
concept unstoppable_token =
    stoppable_token<Token> &&
    requires { requires !Token::stop_possible(); };

} // namespace std
