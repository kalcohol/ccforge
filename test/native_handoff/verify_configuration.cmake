set(_toolchain_args -G "${GENERATOR}"
    -DCMAKE_CXX_STANDARD=${PROBE_STANDARD} -DCMAKE_CXX_STANDARD_REQUIRED=ON
    -DFORGE_ENABLE_FORGE_IO=OFF -DFORGE_BUILD_TESTS=OFF
    -DFORGE_BUILD_EXAMPLES=OFF -DFORGE_ENABLE_INSTALL=OFF)
if(PARENT_CACHE)
    list(PREPEND _toolchain_args -C "${PARENT_CACHE}")
endif()
foreach(_pair "CXX_COMPILER|CMAKE_CXX_COMPILER" "MAKE_PROGRAM|CMAKE_MAKE_PROGRAM"
        "GENERATOR_PLATFORM|CMAKE_GENERATOR_PLATFORM" "GENERATOR_TOOLSET|CMAKE_GENERATOR_TOOLSET")
    string(REPLACE "|" ";" _pair "${_pair}")
    list(GET _pair 0 _source)
    list(GET _pair 1 _destination)
    if(NOT "${${_source}}" STREQUAL "")
        list(APPEND _toolchain_args "-D${_destination}=${${_source}}")
    endif()
endforeach()
file(REMOVE_RECURSE "${BINARY_DIR}")
if(MODE STREQUAL "package")
    set(_publisher "${BINARY_DIR}-publisher")
    set(_prefix "${BINARY_DIR}-prefix")
    file(REMOVE_RECURSE "${_publisher}" "${_prefix}")
    execute_process(COMMAND "${CMAKE_COMMAND}" ${_toolchain_args}
        -S "${FORGE_SOURCE}" -B "${_publisher}"
        -DFORGE_ENABLE_INSTALL=ON -DCMAKE_INSTALL_LIBDIR=lib
        "-DCMAKE_INSTALL_PREFIX=${_prefix}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Package configure failed:\n${_out}\n${_err}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${_publisher}"
        --config "${TEST_CONFIG}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Package install failed:\n${_out}\n${_err}")
    endif()
    list(APPEND _toolchain_args "-DCCForge_DIR=${_prefix}/lib/cmake/CCForge")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" ${_toolchain_args}
    -S "${SOURCE_DIR}" -B "${BINARY_DIR}"
    "-DFORGE_SOURCE=${FORGE_SOURCE}" -DCASE=${CASE} -DMODE=${MODE}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
set(_log "${_out}\n${_err}")
if(CASE MATCHES "^different")
    set(_expected "CC Forge configuration changed after first inclusion")
elseif(CASE STREQUAL "unset")
    set(_expected "CC Forge requires an explicit CMAKE_CXX_STANDARD")
else()
    set(_expected "")
endif()
if(_expected)
    if(_result EQUAL 0 OR NOT _log MATCHES "${_expected}")
        message(FATAL_ERROR "Expected '${_expected}' from configure:\n${_log}")
    endif()
    set(_items "")
    if(CASE STREQUAL "different")
        set(_items FORGE_FORCE_SIMD_BACKPORT FORGE_ENABLE_FORGE_RUNTIME)
    elseif(CASE STREQUAL "different_standard")
        set(_items CMAKE_CXX_STANDARD)
    elseif(CASE STREQUAL "different_extensions")
        set(_items CMAKE_CXX_EXTENSIONS)
        if(NOT _log MATCHES "'undefined' -> 'defined:OFF'")
            message(FATAL_ERROR "Missing dialect values in conflict diagnostic:\n${_log}")
        endif()
    elseif(CASE STREQUAL "different_deployment")
        set(_items CMAKE_OSX_DEPLOYMENT_TARGET)
    elseif(CASE STREQUAL "different_platform")
        set(_items FORGE_FIXTURE_PLATFORM)
    elseif(CASE STREQUAL "different_header")
        set(_items content:backport)
    elseif(CASE STREQUAL "different_toolchain")
        set(_items content:runtime content:backport)
    elseif(CASE STREQUAL "different_environment")
        set(_items environment:CPLUS_INCLUDE_PATH)
    endif()
    foreach(_item IN LISTS _items)
        if(NOT _log MATCHES "${_item}:")
            message(FATAL_ERROR "Missing differing input ${_item}:\n${_log}")
        endif()
    endforeach()
else()
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Configure failed:\n${_log}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BINARY_DIR}"
        --config "${TEST_CONFIG}" --target consumer
        RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(CASE MATCHES "^(mismatch|features|transitive)$")
        set(_log "${_out}\n${_err}")
        if(_result EQUAL 0 OR NOT _log MATCHES "CC Forge language standard mismatch")
            message(FATAL_ERROR "Expected language guard failure:\n${_log}")
        endif()
        foreach(_text "consumer uses C[+][+]26" "probes used C[+][+]23"
                "CMAKE_CXX_STANDARD=23" "align consumer compile features and flags")
            if(NOT _log MATCHES "${_text}")
                message(FATAL_ERROR "Incomplete guard diagnostic (${_text}):\n${_log}")
            endif()
        endforeach()
    elseif(NOT _result EQUAL 0)
        message(FATAL_ERROR "Consistent consumer failed to build:\n${_out}\n${_err}")
    endif()
endif()
