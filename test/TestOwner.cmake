include_guard(GLOBAL)

# Registration and configure probes share the same default until P0-6.
function(_forge_test_owner out)
    cmake_parse_arguments(PARSE_ARGV 1 _test "" "OWNER" "")
    if(_test_UNPARSED_ARGUMENTS OR _test_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Expected optional OWNER STD or OWNER FORGE")
    endif()
    if(NOT DEFINED _test_OWNER)
        set(_test_OWNER FORGE)
    endif()
    if(NOT _test_OWNER MATCHES "^(STD|FORGE)$")
        message(FATAL_ERROR "Unknown Forge test owner: ${_test_OWNER}")
    endif()
    string(TOLOWER "${_test_OWNER}" _owner)
    set(${out} "forge::${_owner}" PARENT_SCOPE)
endfunction()

function(_forge_test_registration name_out target_out default_name)
    set(_owner_args ${ARGN})
    set(_name "${default_name}")
    if(_owner_args)
        list(GET _owner_args 0 _first)
        if(NOT _first STREQUAL "OWNER")
            list(POP_FRONT _owner_args _name)
        endif()
    endif()
    _forge_test_owner(_target ${_owner_args})
    set(${name_out} "${_name}" PARENT_SCOPE)
    set(${target_out} "${_target}" PARENT_SCOPE)
endfunction()

function(_forge_prepare_test_probe)
    _forge_test_owner(_target ${ARGN})
    # try_compile cannot import the local implementation targets. Mirror the
    # include roots and compile definitions needed by the source probes.
    set(_definition_targets forge_std)
    if(FORGE_INCLUDE_DIR)
        list(REMOVE_ITEM CMAKE_REQUIRED_INCLUDES "${FORGE_INCLUDE_DIR}")
        if(_target STREQUAL "forge::forge")
            list(PREPEND CMAKE_REQUIRED_INCLUDES "${FORGE_INCLUDE_DIR}")
        endif()
    endif()
    if(_target STREQUAL "forge::forge")
        list(APPEND _definition_targets forge)
    endif()
    if(FORGE_NEEDS_BACKPORT)
        list(PREPEND CMAKE_REQUIRED_INCLUDES "${FORGE_BACKPORT_DIR}")
    endif()
    foreach(_definition_target IN LISTS _definition_targets)
        if(TARGET ${_definition_target})
            get_target_property(_definitions ${_definition_target} INTERFACE_COMPILE_DEFINITIONS)
            if(_definitions)
                foreach(_definition IN LISTS _definitions)
                    list(APPEND CMAKE_REQUIRED_DEFINITIONS "-D${_definition}")
                endforeach()
            endif()
        endif()
    endforeach()
    set(CMAKE_REQUIRED_INCLUDES "${CMAKE_REQUIRED_INCLUDES}" PARENT_SCOPE)
    set(CMAKE_REQUIRED_DEFINITIONS "${CMAKE_REQUIRED_DEFINITIONS}" PARENT_SCOPE)
endfunction()
