include_guard(GLOBAL)

# Standard tests and configure probes use forge::std unless they opt into Forge.
function(_forge_test_owner out)
    cmake_parse_arguments(PARSE_ARGV 1 _test "" "OWNER" "")
    if(_test_UNPARSED_ARGUMENTS OR _test_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Expected optional OWNER STD or OWNER FORGE")
    endif()
    if(NOT DEFINED _test_OWNER)
        set(_test_OWNER STD)
    endif()
    if(NOT _test_OWNER MATCHES "^(STD|FORGE)$")
        message(FATAL_ERROR "Unknown Forge test owner: ${_test_OWNER}")
    endif()
    string(TOLOWER "${_test_OWNER}" _owner)
    set(${out} "forge::${_owner}" PARENT_SCOPE)
endfunction()

function(_forge_test_registration name_out target_out default_name)
    set(_owner_args ${ARGN})
    set(_name "${default_name}")
    if(_owner_args)
        list(GET _owner_args 0 _first)
        if(NOT _first STREQUAL "OWNER")
            list(POP_FRONT _owner_args _name)
        endif()
    endif()
    _forge_test_owner(_target ${_owner_args})
    set(${name_out} "${_name}" PARENT_SCOPE)
    set(${target_out} "${_target}" PARENT_SCOPE)
endfunction()

function(_forge_filter_extension_include_root)
    set(_extension_root "${FORGE_INCLUDE_DIR}")
    if(NOT _extension_root AND FORGE_ROOT_DIR)
        # Standalone probes can know the root before loading forge.cmake.
        set(_extension_root "${FORGE_ROOT_DIR}/include")
    endif()
    if(NOT _extension_root)
        return()
    endif()
    get_filename_component(_extension_root "${_extension_root}" REALPATH)
    set(_filtered_includes "")
    set(_separator "")
    foreach(_include IN LISTS CMAKE_REQUIRED_INCLUDES)
        get_filename_component(_resolved_include "${_include}" REALPATH)
        if(NOT _resolved_include STREQUAL _extension_root)
            # Keep the caller's spelling and restore escaped list separators.
            string(REPLACE ";" "\\;" _include "${_include}")
            string(APPEND _filtered_includes "${_separator}${_include}")
            set(_separator ";")
        endif()
    endforeach()
    set(CMAKE_REQUIRED_INCLUDES "${_filtered_includes}" PARENT_SCOPE)
endfunction()

function(_forge_check_prepared_cxx_source_compiles source result_var)
    check_cxx_source_compiles("${source}" ${result_var})
endfunction()

# Native checks do not add the shadow root or backport definitions.
function(_forge_check_native_cxx_source_compiles source result_var)
    _forge_filter_extension_include_root()
    _forge_check_prepared_cxx_source_compiles("${source}" ${result_var})
endfunction()

function(_forge_check_native_cxx_source_runs source result_var)
    _forge_filter_extension_include_root()
    check_cxx_source_runs("${source}" ${result_var})
endfunction()

function(_forge_check_std_cxx_source_compiles source result_var)
    _forge_prepare_test_probe(OWNER STD)
    _forge_check_prepared_cxx_source_compiles("${source}" ${result_var})
endfunction()

function(_forge_prepare_test_probe)
    _forge_test_owner(_target ${ARGN})
    # try_compile cannot import the local implementation targets. Mirror the
    # include roots and compile definitions needed by the source probes.
    set(_definition_targets forge_std)
    _forge_filter_extension_include_root()
    if(_target STREQUAL "forge::forge")
        if(FORGE_INCLUDE_DIR)
            list(PREPEND CMAKE_REQUIRED_INCLUDES "${FORGE_INCLUDE_DIR}")
        endif()
        list(APPEND _definition_targets forge)
    endif()
    if(FORGE_NEEDS_BACKPORT)
        list(PREPEND CMAKE_REQUIRED_INCLUDES "${FORGE_BACKPORT_DIR}")
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC"
            AND NOT CMAKE_REQUIRED_FLAGS MATCHES "(^| )/Zc:__cplusplus($| )")
        set(CMAKE_REQUIRED_FLAGS "${CMAKE_REQUIRED_FLAGS} /Zc:__cplusplus" PARENT_SCOPE)
    endif()
    foreach(_definition_target IN LISTS _definition_targets)
        if(TARGET ${_definition_target})
            get_target_property(_definitions ${_definition_target} INTERFACE_COMPILE_DEFINITIONS)
            if(_definitions)
                foreach(_definition IN LISTS _definitions)
                    list(APPEND CMAKE_REQUIRED_DEFINITIONS "-D${_definition}")
                endforeach()
            endif()
        endif()
    endforeach()
    set(CMAKE_REQUIRED_INCLUDES "${CMAKE_REQUIRED_INCLUDES}" PARENT_SCOPE)
    set(CMAKE_REQUIRED_DEFINITIONS "${CMAKE_REQUIRED_DEFINITIONS}" PARENT_SCOPE)
endfunction()
