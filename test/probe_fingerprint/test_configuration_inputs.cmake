cmake_minimum_required(VERSION 3.20)
get_filename_component(FORGE_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(FORGE_CMAKE_DIR "${FORGE_ROOT_DIR}/cmake")
set(FORGE_INCLUDE_DIR "${FORGE_ROOT_DIR}/include")
set(FORGE_BACKPORT_DIR "${FORGE_ROOT_DIR}/backport")
set(_FORGE_CURRENT_LIST_DIR "${FORGE_ROOT_DIR}")
set(CMAKE_CXX_STANDARD 23)
foreach(_feature SIMD SENDERS CONSTANT_WRAPPER MDSPAN_PADDED_LAYOUTS SUBMDSPAN LINALG HIVE)
    set(FORGE_FORCE_${_feature}_BACKPORT OFF)
endforeach()
include("${FORGE_CMAKE_DIR}/ForgeConfiguration.cmake")

# Stop the first inclusion's extension module after its real option
# declarations and before its probes or targets. Each function below is a
# sibling-like local scope, sharing the cache and the configuration record.
macro(_forge_compute_probe_fingerprint)
    if(_expect_reinclusion)
        message(FATAL_ERROR "Matching inclusion unexpectedly attempted runtime probes")
    endif()
    return()
endmacro()

function(_forge_first_inclusion)
    if(CASE MATCHES "^(same_standard_only|different_mode_on)$")
        set(FORGE_ENABLE_EXTENSIONS OFF)
    else()
        set(FORGE_ENABLE_EXTENSIONS ON)
        set(FORGE_ENABLE_FORGE_RUNTIME ON)
        set(FORGE_ENABLE_FORGE_RESOURCE_POLICY ON)
        if(CASE STREQUAL "different_local_io")
            set(FORGE_ENABLE_FORGE_IO OFF)
            set(FORGE_ENABLE_FORGE_IO_URING OFF)
        endif()
    endif()
    _forge_check_configuration(_already_configured)
    if(_already_configured)
        message(FATAL_ERROR "First inclusion unexpectedly matched a previous configuration")
    endif()
    if(FORGE_ENABLE_EXTENSIONS)
        include("${FORGE_CMAKE_DIR}/ForgeExtensions.cmake")
        foreach(_option FORGE_ENABLE_FORGE_IO FORGE_ENABLE_FORGE_IO_URING)
            if(NOT "$CACHE{${_option}}" STREQUAL "AUTO")
                message(FATAL_ERROR "${_option} cache default must remain AUTO")
            endif()
            if(CASE STREQUAL "different_local_io" AND NOT "${${_option}}" STREQUAL "OFF")
                message(FATAL_ERROR "${_option} lost its directory-local override")
            endif()
        endforeach()
    endif()
endfunction()

function(_forge_reinclude)
    if(CASE MATCHES "^(same_standard_only|different_mode_off)$")
        set(FORGE_ENABLE_EXTENSIONS OFF)
    else()
        set(FORGE_ENABLE_EXTENSIONS ON)
    endif()
    if(DEFINED FORGE_ENABLE_FORGE_RUNTIME OR DEFINED FORGE_ENABLE_FORGE_RESOURCE_POLICY)
        message(FATAL_ERROR "The first inclusion's local overrides leaked into the sibling")
    endif()
    if(CASE STREQUAL "same_standard_only")
        set(FORGE_ENABLE_FORGE_IO OFF)
    elseif(CASE STREQUAL "different_full")
        set(FORGE_FORCE_SIMD_BACKPORT ON)
        set(FORGE_ENABLE_FORGE_RUNTIME OFF)
    endif()
    set(_expect_reinclusion ON)
    include("${FORGE_ROOT_DIR}/forge.cmake")
    # A matching reinclusion must return before recomputing the probe fingerprint.
    if(DEFINED _forge_runtime_probe_fingerprint OR DEFINED CACHE{FORGE_RUNTIME_PROBE_FINGERPRINT})
        message(FATAL_ERROR "Matching reinclusion recomputed the runtime probe fingerprint")
    endif()
    if(CASE STREQUAL "same_full")
        if(NOT "${FORGE_ENABLE_FORGE_RUNTIME}" STREQUAL "ON"
                OR NOT "${FORGE_ENABLE_FORGE_RESOURCE_POLICY}" STREQUAL "ON"
                OR NOT "${FORGE_ENABLE_FORGE_IO}" STREQUAL "AUTO"
                OR NOT "${FORGE_ENABLE_FORGE_IO_URING}" STREQUAL "AUTO")
            message(FATAL_ERROR "Matching full reinclusion did not expose the effective options")
        endif()
    elseif(CASE STREQUAL "same_standard_only")
        if(DEFINED FORGE_ENABLE_FORGE_RUNTIME OR DEFINED FORGE_ENABLE_FORGE_RESOURCE_POLICY
                OR DEFINED CACHE{FORGE_ENABLE_FORGE_IO}
                OR DEFINED CACHE{FORGE_ENABLE_FORGE_IO_URING})
            message(FATAL_ERROR "Standard-only reinclusion declared extension options")
        endif()
    endif()
endfunction()

_forge_first_inclusion()
_forge_reinclude()

if(CASE STREQUAL "same_full")
    foreach(_option FORGE_ENABLE_FORGE_RUNTIME FORGE_ENABLE_FORGE_RESOURCE_POLICY)
        get_property(_type CACHE "${_option}" PROPERTY TYPE)
        if(NOT _type STREQUAL "BOOL" OR NOT "$CACHE{${_option}}" STREQUAL "ON")
            message(FATAL_ERROR "Matching full reinclusion did not create the shared ${_option}:BOOL=ON cache entry")
        endif()
    endforeach()
endif()
