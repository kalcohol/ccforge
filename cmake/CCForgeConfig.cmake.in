@PACKAGE_INIT@

set_and_check(_CCFORGE_PACKAGE_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(_CCFORGE_PACKAGE_BACKPORT_DIR "@PACKAGE_FORGE_INSTALL_BACKPORTDIR@")
set(_CCFORGE_PACKAGE_PREFIX "${PACKAGE_PREFIX_DIR}")
set(_CCFORGE_PACKAGE_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")

include("${CMAKE_CURRENT_LIST_DIR}/forge.cmake")

unset(_CCFORGE_PACKAGE_CMAKE_DIR)
unset(_CCFORGE_PACKAGE_BACKPORT_DIR)
unset(_CCFORGE_PACKAGE_INCLUDE_DIR)
unset(_CCFORGE_PACKAGE_PREFIX)

check_required_components(CCForge)
